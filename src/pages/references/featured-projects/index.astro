---
import DefaultLayout from '../../../layouts/DefaultLayout.astro';
import Icon from '../../../components/Icon.astro';
import { siteData } from '../../../data';

const fp = siteData.featured_projects;
---
<DefaultLayout
  title="Ausgewählte Projekte von STORB Consulting"
  description="STORB Consulting - Ausgewählte Projekte in IT, E‑Government und Industrie: präzise umgesetzt, verantwortungsbewusst geführt und klar dokumentiert."
  author="Christian Storb"
  locale="de_DE"
  seo={{ type: 'WebPage' }}
  image="/assets/images/consulting/og-image.png"
  twitter={{ card: 'summary_large_image', creator: '@ChristianStorb' }}
  robots="index, follow"
>
  <div class="container">
    <!-- Intro -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-10 text-center">
        <h2 class="display-5 fw-bold mb-4">{fp.intro.headline}</h2>
        <p class="lead text-muted col-lg-8 mx-auto">
          {fp.intro.text}
        </p>
      </div>
    </div>

    <!-- Project Grid -->
    <div class="row row-cols-1 row-cols-lg-2 g-4 mb-5">
      {fp.projects.map((project: any) => (
        <div class="col">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent border-0 d-flex align-items-center gap-3 pt-4 px-4">
              <div class="p-3 bg-primary-subtle text-primary rounded-3">
                <Icon icon={project.icon} type={project.type} />
              </div>
              <div>
                <h2 class="h5 fw-bold mb-1">{project.title}</h2>
                <p class="mb-0 text-muted small text-uppercase">{project.subtitle}</p>
              </div>
            </div>
            <div class="card-body px-4 pb-4">
              <p class="card-text mb-4">{project.description}</p>

              {project.highlights && (
                <ul class="list-unstyled mb-0 bg-body-tertiary p-3 rounded-3">
                  {project.highlights.map((highlight: string) => (
                    <li class="d-flex align-items-start gap-2 mb-2 last-mb-0">
                      <span class="material-symbols-outlined fs-6 mt-1 text-primary">arrow_right</span>
                      <span class="small">{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Back Link -->
    <div class="row justify-content-center text-center">
      <div class="col-12">
        <a href="/references" class="btn btn-link text-decoration-none">
          <span class="material-symbols-outlined align-middle me-1">arrow_back</span>
          Zurück zur Übersicht
        </a>
      </div>
    </div>
  </div>

  <style>
    .last-mb-0:last-child {
      margin-bottom: 0 !important;
    }
  </style>
</DefaultLayout>
