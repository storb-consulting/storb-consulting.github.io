  <address itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
    <strong><span itemprop="name">STORB Consulting</span></strong><br>
    Christian Storb<br>
    <span itemprop="streetAddress">Humboldtweg 3</span><br>
    <span itemprop="postalCode">48301</span> <span itemprop="addressLocality">Nottuln</span><br>
    <span itemprop="addressCountry">Deutschland</span>
  </address>

  📱 Telefon: <span itemprop="telephone">+49 (0) 1590 6810 667</span><br>
  ✉️ E‑Mail: <a itemprop="email" href="mailto:${siteConfig.email}">${siteConfig.email}</a><br>
  🌐 Webseite: <a itemprop="url" href="${siteConfig.url}">${siteConfig.url}</a>
</div>  

*Diese Datenschutzerklärung gilt für alle Dienste und Online‑Auftritte von Christian Storb, STORB Consulting und verbundene Unternehmen.*
`;

const html = marked.parse(md) as string;
---
<DefaultLayout
  title={pageTitle}
  description="Informationen zum Datenschutz bei STORB Consulting – transparent, rechtssicher und aktuell."
  author="Christian Storb"
  locale="de_DE"
  seo={{ type: 'WebPage' }}
  image="/assets/images/consulting/og-image.png"
  twitter={{ card: 'summary_large_image', creator: '@ChristianStorb' }}
  robots="index, follow"
>
  <Fragment set:html={html} />
</DefaultLayout>
