---
import DefaultLayout from '../../../layouts/DefaultLayout.astro';
import { siteConfig, siteData } from '../../../data';
import { getSortedPosts, getPostUrl, getPostExcerptText, formatDateShort } from '../../../utils/posts';

const contacts = siteData.contacts;
const allPosts = await getSortedPosts();
const authorPosts = allPosts.filter((post) => {
  const a = post.data.author;
  if (typeof a === 'string') return a === 'Christian Storb';
  if (a && typeof a === 'object' && 'name' in a) return (a as any).name === 'Christian Storb';
  return false;
});
---
<DefaultLayout
  title="Autor bei STORB Consulting"
  description="Christian Storb – IT-Berater & Inhaber von STORB Consulting. Experte für .NET, Cloud & Azure mit über 20 Jahren Erfahrung. Erfahren Sie mehr über meine Projekte."
  locale="de_DE"
  seo={{ type: 'WebPage' }}
  image="/assets/images/consulting/og-image.png"
  twitter={{ card: 'summary_large_image', creator: '@ChristianStorb' }}
  robots="index, follow"
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "@id": "https://storb-consulting.github.io/#person",
      "name": "Christian Storb",
      "jobTitle": "Softwareentwickler und IT-Berater",
      "description": "Christian Storb – Inhaber von STORB Consulting. Fundierte Ausbildung, langjährige Erfahrung und klare Schwerpunkte.",
      "image": "https://storb-consulting.github.io/assets/images/consulting/authors/christian-storb.jpg",
      "url": "https://storb-consulting.github.io",
      "email": "mail2storb@gmail.com",
      "worksFor": [
        {
          "@type": "Organization",
          "name": "STORB Consulting",
          "url": "https://storb-consulting.github.io"
        },
        {
          "@type": "Organization",
          "name": "DBT Digital Building Technology",
          "url": "https://www2.wibutler.com/"
        }
      ],
      "sameAs": [
        "https://github.com/chstorb",
        "https://www.linkedin.com/in/christian-storb-326249aa/",
        "https://twitter.com/ChristianStorb",
        "https://www.instagram.com/storbconsulting",
        "https://www.facebook.com/storb.christian"
      ],
      "knowsAbout": [
        ".NET Softwarearchitektur und -entwicklung",
        "Cloud Computing (Azure)",
        "IT-Strategy & Consulting",
        "Microservices",
        "Legacy System Modernization"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "FH Münster",
        "url": "https://www.fh-muenster.de"
      }
    }
  }
  </script>

  <div class="container">
    <div class="row g-5">
      <!-- Left Column: Profile & Philosophy -->
      <div class="col-lg-5">
        <div class="sticky-lg-top" style="top: 2rem; z-index: 1;">
          <!-- Profile Card -->
          <div class="card border-0 shadow-sm bg-body-tertiary mb-4">
            <div class="card-body p-4 text-center">
              <img src="/assets/images/consulting/authors/christian-storb.jpg" alt="Christian Storb - IT Consultant und Softwareentwickler" class="mb-3 mx-auto rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
              <h2 class="h3 fw-bold mb-1">{contacts.profile.name}</h2>
              <p class="text-primary fw-medium mb-3">{contacts.profile.role}</p>

              <hr class="my-4 opacity-10" />

              <div class="text-start">
                <h6 class="text-uppercase text-muted small fw-bold mb-3">Qualifikation</h6>
                <ul class="list-unstyled mb-4">
                  {contacts.qualifications.map((qual: string) => (
                    <li class="d-flex align-items-center mb-2">
                      <span class="material-symbols-outlined text-success me-2 fs-6">check_circle</span>
                      {qual}
                    </li>
                  ))}
                </ul>

                <h6 class="text-uppercase text-muted small fw-bold mb-3">Schwerpunkte</h6>
                <div class="d-flex flex-wrap gap-2">
                  {contacts.focus_areas.map((focus: string) => (
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill fw-normal px-3 py-2">
                      {focus}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Philosophy -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="card-title fw-bold mb-3">Unsere Philosophie</h5>
              {contacts.profile.philosophy.map((para: string) => (
                <p class="text-muted small mb-3 last-mb-0">{para}</p>
              ))}
            </div>
          </div>

          <!-- Contact Info -->
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <h5 class="card-title fw-bold mb-3">Kontakt</h5>
              <ul class="list-unstyled mb-0">
                <li class="mb-2">
                  <a href={`mailto:${siteConfig.author.email}`} class="text-decoration-none d-flex align-items-center">
                    <span class="material-symbols-outlined me-2 fs-5">mail</span>
                    {siteConfig.author.email}
                  </a>
                </li>
                <li class="mb-2">
                  <a href={siteConfig.author.linkedin} target="_blank" rel="noopener" class="text-decoration-none d-flex align-items-center">
                    <span class="material-symbols-outlined me-2 fs-5">link</span>
                    LinkedIn
                  </a>
                </li>
                <li>
                  <a href={siteConfig.author.github} target="_blank" rel="noopener" class="text-decoration-none d-flex align-items-center">
                    <span class="material-symbols-outlined me-2 fs-5">code</span>
                    GitHub
                  </a>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Publications -->
      <div class="col-lg-7">
        <h2 class="h4 border-bottom pb-3 mb-4">Veröffentlichungen</h2>

        <div class="timeline">
          {authorPosts.map((post) => {
            const url = getPostUrl(post);
            const cats = Array.isArray(post.data.categories)
              ? post.data.categories.slice(0, 2)
              : post.data.categories
              ? [post.data.categories]
              : [];
            return (
              <div class="timeline-item position-relative ps-4 pb-5 last-pb-0">
                <!-- Dot -->
                <div class="position-absolute start-0 top-0 translate-middle-x bg-primary rounded-circle border border-4 border-body" style="width: 16px; height: 16px; margin-top: 0.4rem;"></div>
                <!-- Content -->
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <span class="badge bg-secondary-subtle text-body-secondary">{formatDateShort(post.data.date || new Date())}</span>
                      {cats.length > 0 && (
                        <div class="d-flex gap-1">
                          {cats.map((cat) => (
                            <span class="badge bg-light text-dark border">{cat}</span>
                          ))}
                        </div>
                      )}
                    </div>
                    <h3 class="h5 fw-bold mb-2">
                      <a href={url} class="text-decoration-none text-reset">{post.data.title}</a>
                    </h3>
                    <p class="card-text text-muted mb-3">
                      {getPostExcerptText(post.body || '', 30)}
                    </p>
                    <a href={url} class="fw-medium text-decoration-none">
                      Artikel lesen <span class="material-symbols-outlined fs-6 align-text-bottom">arrow_forward</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <style>
    .timeline {
      border-left: 2px solid var(--bs-border-color);
      margin-left: 0.5rem;
    }
    .last-mb-0:last-child {
      margin-bottom: 0 !important;
    }
    .last-pb-0:last-child {
      padding-bottom: 0 !important;
    }
  </style>
</DefaultLayout>
