---
import { siteData } from '../data/index';

interface Props {
  slot?: string;
  client?: string;
  format?: string;
  max_width?: string;
  class?: string;
}

const {
  slot = siteData.ads.google_adsense?.slots?.home_1 || "1111111111",
  client = siteData.ads.google_adsense?.client || "ca-pub-6012977884316456",
  format = "auto",
  max_width = "760px",
  class: adClass = "my-5"
} = Astro.props;
---
<div class={`container-xl ${adClass}`} style={`max-width: ${max_width};`}>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client={client}
       data-ad-slot={slot}
       data-ad-format={format}
       data-full-width-responsive="true"></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
